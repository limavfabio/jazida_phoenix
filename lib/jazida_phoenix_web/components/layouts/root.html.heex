<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-stone-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#10231c" />
    <.live_title default="Jazida — oportunidades minerais" suffix=" · Jazida" phx-no-format>
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="h-full bg-[#f4f1e9] text-[#183128] antialiased selection:bg-[#ff5d39] selection:text-white">
    {@inner_content}
  </body>
</html>
