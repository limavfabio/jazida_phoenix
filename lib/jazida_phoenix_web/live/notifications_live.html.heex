<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="notifications-page" class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <h1 class="text-2xl font-semibold tracking-tight">Alertas</h1>
    <p class="mt-1.5 max-w-xl text-sm text-[#69726c]">
      Alterações nos processos que você acompanha.
    </p>

    <div
      id="notifications"
      phx-update="stream"
      class="mt-8 overflow-hidden rounded-lg border border-[#dfe3df] bg-white"
    >
      <div
        id="notifications-empty"
        class="hidden only:block p-10 text-center"
      >
        <.icon name="hero-bell-slash" class="mx-auto size-7 text-[#69726c]" />
        <p class="mt-3 font-semibold">Nenhuma alteração por enquanto</p>
        <p class="mt-1 text-sm text-[#69726c]">
          Abra uma área no mapa e escolha “Acompanhar mudanças”.
        </p>
        <.link
          navigate={~p"/"}
          class="mt-5 inline-flex rounded-md bg-[#1d5b45] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#174936]"
        >Abrir mapa</.link>
      </div>

      <article
        :for={{id, notification} <- @streams.notifications}
        id={id}
        class={[
          "group grid gap-4 border-b border-[#edf0ed] p-5 last:border-b-0 sm:grid-cols-[1fr_auto]",
          if(notification.read_at,
            do: "bg-[#fafbf9] text-[#69726c]",
            else: "bg-white"
          )
        ]}
      >
        <div>
          <div class="flex items-center gap-2">
            <span :if={!notification.read_at} class="size-2 rounded-full bg-[#1d5b45]"></span>
            <p class="font-mono text-xs font-medium">
              {notification.mining_process.process_number}
            </p>
          </div>
          <p class="mt-2 font-semibold">Mudança em {notification.process_change.field}</p>
          <p class="mt-1 text-xs text-[#69726c]">
            Observada em {Calendar.strftime(
              notification.process_change.observed_at,
              "%d/%m/%Y às %H:%M UTC"
            )}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button
            :if={!notification.read_at}
            type="button"
            id={"mark-read-#{notification.id}"}
            phx-click="mark_read"
            phx-value-id={notification.id}
            class="rounded-md border border-[#cfd5d0] px-3 py-2 text-xs font-semibold transition hover:bg-[#f0f2f0]"
          >Marcar como lido</button>
          <.link
            navigate={~p"/?process=#{notification.mining_process_id}"}
            class="grid size-9 place-items-center rounded-md bg-[#1d5b45] text-white transition hover:bg-[#174936]"
            aria-label="Abrir processo no mapa"
          >
            <.icon name="hero-arrow-up-right" class="size-4" />
          </.link>
        </div>
      </article>
    </div>
  </section>
</Layouts.app>
