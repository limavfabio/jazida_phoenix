<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="explorer" class="mx-auto max-w-[1600px] sm:p-4">
    <div class="grid min-h-[calc(100vh-3.5rem)] overflow-hidden border-[#dfe3df] bg-white sm:rounded-lg sm:border lg:h-[calc(100vh-5.5rem)] lg:grid-cols-[360px_minmax(0,1fr)] lg:grid-rows-[minmax(0,1fr)]">
      <aside class="relative z-20 flex min-h-0 max-h-[55vh] flex-col border-b border-[#dfe3df] bg-white lg:max-h-full lg:border-r lg:border-b-0">
        <div class="border-b border-[#dfe3df] p-4">
          <h1 class="text-lg font-semibold tracking-tight text-[#1f2823]">
            Explorar áreas
          </h1>
          <p class="mt-1 text-sm text-[#69726c]">
            Consulte processos e áreas públicas da ANM.
          </p>

          <.form
            for={@filter_form}
            id="explorer-filter-form"
            phx-change="filter"
            class="mt-4 space-y-2"
          >
            <div class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="pointer-events-none absolute top-1/2 left-3 z-10 size-4 -translate-y-1/2 text-[#69726c]"
              />
              <.input
                field={@filter_form[:q]}
                type="search"
                aria-label="Buscar por processo, município ou substância"
                placeholder="Processo, município ou substância"
                phx-debounce="350"
                class="h-11 w-full rounded-md border border-[#cfd5d0] bg-white pr-3 pl-9 text-sm text-[#1f2823] outline-none transition placeholder:text-[#8a928d] focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
              />
            </div>
            <div class="grid grid-cols-2 gap-2">
              <.input
                field={@filter_form[:state]}
                type="text"
                aria-label="Filtrar por unidade federativa"
                maxlength="2"
                placeholder="UF"
                phx-debounce="350"
                class="h-10 w-full rounded-md border border-[#cfd5d0] bg-white px-3 text-sm uppercase outline-none transition focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
              />
              <.input
                field={@filter_form[:category]}
                type="select"
                aria-label="Filtrar por categoria de navegação"
                prompt="Todas as situações"
                options={[
                  {"Para análise", "pending_analysis"},
                  {"Em análise", "under_analysis"},
                  {"Apta", "eligible"},
                  {"Não apta", "not_eligible"},
                  {"Livre", "free"},
                  {"Arrematada", "awarded"}
                ]}
                class="h-10 w-full rounded-md border border-[#cfd5d0] bg-white px-3 text-sm outline-none transition focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
              />
            </div>
            <details
              id="advanced-filters"
              class="group rounded-md border border-[#dfe3df] bg-white"
            >
              <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-2.5 text-xs font-medium text-[#69726c]">
                Filtros avançados
                <.icon name="hero-chevron-down" class="size-4 transition group-open:rotate-180" />
              </summary>
              <div class="grid gap-2 border-t border-[#dfe3df] p-3 sm:grid-cols-2 lg:grid-cols-1">
                <.input
                  field={@filter_form[:municipality]}
                  type="text"
                  aria-label="Filtrar por município"
                  placeholder="Município"
                  phx-debounce="350"
                  class="h-10 w-full rounded-md border border-[#cfd5d0] bg-white px-3 text-sm outline-none focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
                />
                <.input
                  field={@filter_form[:substance]}
                  type="text"
                  aria-label="Filtrar por substância"
                  placeholder="Substância"
                  phx-debounce="350"
                  class="h-10 w-full rounded-md border border-[#cfd5d0] bg-white px-3 text-sm outline-none focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
                />
                <.input
                  field={@filter_form[:status]}
                  type="text"
                  aria-label="Filtrar por situação oficial"
                  placeholder="Situação oficial"
                  phx-debounce="350"
                  class="h-10 w-full rounded-md border border-[#cfd5d0] bg-white px-3 text-sm outline-none focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
                />
                <.input
                  field={@filter_form[:regime]}
                  type="text"
                  aria-label="Filtrar por regime"
                  placeholder="Regime"
                  phx-debounce="350"
                  class="h-10 w-full rounded-md border border-[#cfd5d0] bg-white px-3 text-sm outline-none focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
                />
                <.input
                  field={@filter_form[:round]}
                  type="number"
                  aria-label="Filtrar por número da rodada"
                  min="1"
                  placeholder="Rodada"
                  phx-debounce="350"
                  class="h-10 w-full rounded-md border border-[#cfd5d0] bg-white px-3 text-sm outline-none focus:border-[#1d5b45] focus:ring-3 focus:ring-[#1d5b45]/10"
                />
              </div>
            </details>
          </.form>

          <div class="mt-3 flex items-center justify-between text-[11px] text-[#69726c]">
            <span class="inline-flex items-center gap-1.5">
              <span class={[
                "size-2 rounded-full",
                if(@stale?, do: "bg-amber-500", else: "bg-emerald-500")
              ]}></span>
              <%= if @source_import do %>
                <%= if @latest_source_import.status == "failed" do %>
                  Última sincronização falhou · exibindo dados de {Calendar.strftime(
                    @source_import.finished_at,
                    "%d/%m/%Y"
                  )}
                <% else %>
                  <%= if @stale? do %>
                    Dados possivelmente desatualizados · {Calendar.strftime(
                      @source_import.finished_at,
                      "%d/%m/%Y"
                    )}
                  <% else %>
                    Dados de {Calendar.strftime(@source_import.finished_at, "%d/%m/%Y")}
                  <% end %>
                <% end %>
              <% else %>
                Aguardando primeira sincronização
              <% end %>
            </span>
            <button
              :if={@filters != %{}}
              type="button"
              phx-click="clear_filters"
              id="clear-filters"
              class="font-medium text-[#1d5b45] hover:underline"
            >
              Limpar
            </button>
          </div>
        </div>

        <div id="process-results" phx-update="stream" class="min-h-0 flex-1 overflow-y-auto">
          <div
            id="results-empty"
            class="hidden only:grid min-h-40 place-items-center p-6 text-center"
          >
            <div>
              <.icon name="hero-map-pin" class="mx-auto size-5 text-[#69726c]" />
              <p class="mt-2 text-sm font-semibold">Nenhuma área encontrada</p>
              <p class="mt-1 text-xs text-[#69726c]">Revise ou limpe os filtros.</p>
            </div>
          </div>
          <.link
            :for={{id, process} <- @streams.processes}
            id={id}
            patch={~p"/?#{compact_params(Map.put(@filters, "process", process.id))}"}
            class="group block border-b border-[#edf0ed] px-4 py-3 transition hover:bg-[#f7f7f5]"
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-mono text-xs font-medium text-[#1f2823]">
                  {process.process_number}
                </p>
                <p class="mt-1 line-clamp-1 text-sm font-medium">
                  {Enum.join(process.municipalities, ", ")}
                </p>
              </div>
              <.icon
                name="hero-arrow-up-right"
                class="size-4 text-[#8a928d] transition group-hover:text-[#1d5b45]"
              />
            </div>
            <div class="mt-2 flex items-center gap-2 text-[11px] text-[#69726c]">
              <span
                :if={process.availability}
                class="inline-flex items-center gap-1.5"
              >
                <span class={[
                  "size-1.5 rounded-full",
                  category_color(process.availability.display_category)
                ]}></span>
                {category_label(process.availability.display_category)}
              </span>
              <span>{process.state_code}</span>
              <span :if={process.area_ha}>{process.area_ha} ha</span>
            </div>
          </.link>
        </div>
      </aside>

      <section class="relative min-h-[45vh] overflow-hidden bg-[#e8ece9] lg:min-h-0">
        <div
          id="mining-map"
          phx-hook="MiningMap"
          phx-update="ignore"
          data-style-url={@map_style_url}
          data-satellite-tilejson-url={@satellite_tilejson_url}
          data-states-url-template={@states_geojson_url_template}
          data-tile-url="/tiles/{z}/{x}/{y}"
          class="absolute inset-0"
        >
          <div
            class="absolute inset-0 grid place-items-center bg-[#e8ece9] text-sm text-[#69726c]"
            data-map-loading
          >
            <span class="inline-flex items-center gap-2 rounded-md border border-[#dfe3df] bg-white px-3 py-2 shadow-sm">
              <.icon name="hero-arrow-path" class="size-4 animate-spin text-[#1d5b45]" />
              Carregando território…
            </span>
          </div>
        </div>

        <div data-map-layers class="absolute top-4 right-4 z-10 flex flex-col items-end">
          <button
            type="button"
            id="map-layers-toggle"
            data-map-layers-toggle
            aria-expanded="false"
            aria-controls="map-layers-panel"
            class="grid size-10 place-items-center rounded-md border border-[#dfe3df] bg-white text-[#1f2823] shadow-sm transition hover:bg-[#f7f7f5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1d5b45]"
          >
            <span class="sr-only">Configurar camadas do mapa</span>
            <.icon name="hero-square-3-stack-3d" class="size-5" />
          </button>

          <div
            id="map-layers-panel"
            data-map-layers-panel
            hidden
            class="mt-2 w-[min(18rem,calc(100vw-2rem))] rounded-lg border border-[#dfe3df] bg-white p-4 text-[#1f2823] shadow-lg"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="font-semibold">Camadas do mapa</h2>
              </div>
              <span
                data-map-layer-status
                class="max-w-28 text-right text-[10px] leading-tight text-[#69726c]"
                role="status"
              ></span>
            </div>

            <fieldset class="mt-4">
              <legend class="text-[10px] font-bold tracking-wider uppercase">Mapa base</legend>
              <div class="mt-2 grid grid-cols-2 rounded-md bg-[#f0f2f0] p-1">
                <button
                  type="button"
                  id="basemap-street"
                  data-basemap="street"
                  aria-pressed="true"
                  class="rounded px-3 py-2 text-xs font-medium transition aria-pressed:bg-[#1f2823] aria-pressed:text-white"
                >
                  Ruas
                </button>
                <button
                  :if={@satellite_tilejson_url}
                  type="button"
                  id="basemap-satellite"
                  data-basemap="satellite"
                  aria-pressed="false"
                  class="rounded px-3 py-2 text-xs font-medium transition aria-pressed:bg-[#1f2823] aria-pressed:text-white"
                >
                  Satélite
                </button>
              </div>
            </fieldset>

            <fieldset class="mt-4 space-y-3 border-t border-[#dfe3df] pt-4">
              <legend class="sr-only">Camadas de dados</legend>
              <label
                for="map-layer-mining"
                class="flex cursor-pointer items-center justify-between gap-3 text-xs font-medium"
              >
                Áreas minerárias
                <span class="relative inline-flex h-6 w-10 shrink-0 items-center">
                  <input
                    id="map-layer-mining"
                    data-layer-toggle="mining"
                    type="checkbox"
                    checked
                    class="peer sr-only"
                  />
                  <span class="absolute inset-0 rounded-full bg-[#cfd5d0] transition peer-checked:bg-[#1d5b45]"></span>
                  <span class="relative ml-1 size-4 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></span>
                </span>
              </label>
              <label
                for="map-layer-states"
                class="flex cursor-pointer items-center justify-between gap-3 text-xs font-medium"
              >
                Marcações estaduais
                <span class="relative inline-flex h-6 w-10 shrink-0 items-center">
                  <input
                    id="map-layer-states"
                    data-layer-toggle="states"
                    type="checkbox"
                    checked
                    class="peer sr-only"
                  />
                  <span class="absolute inset-0 rounded-full bg-[#cfd5d0] transition peer-checked:bg-[#1d5b45]"></span>
                  <span class="relative ml-1 size-4 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></span>
                </span>
              </label>
            </fieldset>

            <div
              data-mining-opacity-control
              class="mt-4 border-t border-[#dfe3df] pt-4 transition"
            >
              <div class="flex items-center justify-between gap-3">
                <label
                  for="map-mining-opacity"
                  class="text-[10px] font-bold tracking-wider uppercase"
                >Opacidade das áreas</label>
                <output
                  data-mining-opacity-output
                  for="map-mining-opacity"
                  class="font-mono text-[10px] text-[#69726c]"
                >100%</output>
              </div>
              <input
                id="map-mining-opacity"
                data-mining-opacity
                type="range"
                min="30"
                max="100"
                step="5"
                value="100"
                class="mt-2 h-1.5 w-full cursor-pointer accent-[#1d5b45] disabled:cursor-not-allowed"
              />
            </div>
          </div>
        </div>

        <div
          id="map-legend"
          class="pointer-events-none absolute top-4 left-4 z-10 hidden rounded-md border border-[#dfe3df] bg-white/95 p-3 text-[10px] shadow-sm md:block"
        >
          <p class="font-bold tracking-wide uppercase">Situação</p>
          <div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1.5 text-[#69726c]">
            <span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-emerald-500"></i>Apta</span>
            <span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-amber-400"></i>Para análise</span>
            <span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-orange-500"></i>Em análise</span>
            <span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-stone-400"></i>Não apta</span>
          </div>
        </div>

        <article
          :if={@selected_process}
          id="process-detail"
          class="absolute right-3 bottom-3 left-3 z-20 max-h-[78%] overflow-y-auto rounded-lg border border-[#dfe3df] bg-white p-5 shadow-xl sm:left-auto sm:w-[390px]"
        >
          <button
            type="button"
            id="close-process-detail"
            phx-click="close_process"
            aria-label="Fechar detalhes"
            class="absolute top-3 right-3 grid size-8 place-items-center rounded-md text-[#69726c] transition hover:bg-[#f0f2f0] hover:text-[#1f2823]"
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
          <p class="text-xs font-medium text-[#69726c]">Processo minerário</p>
          <h2 class="mt-1 font-mono text-xl font-semibold">
            {@selected_process.process_number}
          </h2>
          <p class="mt-1 pr-10 text-sm font-semibold">
            {Enum.join(@selected_process.municipalities, ", ")} · {@selected_process.state_code}
          </p>

          <dl class="mt-5 grid grid-cols-2 border-t border-[#dfe3df] text-sm">
            <div class="border-r border-b border-[#dfe3df] py-3 pr-3">
              <dt class="text-[10px] tracking-wide text-[#69726c] uppercase">Área</dt><dd class="mt-1 font-medium">
                {@selected_process.area_ha || "—"} ha
              </dd>
            </div>
            <div class="border-b border-[#dfe3df] py-3 pl-3">
              <dt class="text-[10px] tracking-wide text-[#69726c] uppercase">Fase</dt><dd class="mt-1 font-medium">
                {@selected_process.phase || "—"}
              </dd>
            </div>
            <div class="col-span-2 border-b border-[#dfe3df] py-3">
              <dt class="text-[10px] tracking-wide text-[#69726c] uppercase">Substâncias</dt><dd class="mt-1 font-medium">
                {Enum.join(@selected_process.substances, ", ") |> blank_fallback()}
              </dd>
            </div>
            <div class="col-span-2 border-b border-[#dfe3df] py-3">
              <dt class="text-[10px] tracking-wide text-[#69726c] uppercase">Último evento</dt><dd class="mt-1 font-medium">
                {@selected_process.last_event || "—"}
              </dd>
            </div>
          </dl>

          <div
            :if={@selected_process.availability}
            class="mt-4 border-l-2 border-[#1d5b45] bg-[#f7f7f5] p-3"
          >
            <p class="text-[10px] tracking-wide text-[#69726c] uppercase">Situação oficial</p>
            <p class="mt-1 font-semibold">
              {@selected_process.availability.latest_edital_status_raw ||
                @selected_process.availability.stock_status_raw}
            </p>
            <p class="mt-1 text-xs leading-5 text-[#69726c]">
              Categoria de navegação: {category_label(
                @selected_process.availability.display_category
              )} · Regime: {@selected_process.availability.availability_regime || "não informado"}.
            </p>
            <p class="mt-1 text-[10px] text-[#8a928d]">
              Fonte observada em {Calendar.strftime(
                @selected_process.availability.source_observed_at,
                "%d/%m/%Y às %H:%M UTC"
              )}
            </p>
          </div>

          <div
            :if={@selected_process.round_areas != []}
            id="round-history"
            class="mt-4 border-t border-[#dfe3df] pt-4"
          >
            <p class="text-[10px] tracking-wide text-[#69726c] uppercase">Histórico de rodadas</p>
            <div
              :for={area <- @selected_process.round_areas}
              class="mt-2 border-t border-[#edf0ed] pt-2 text-xs first:border-0 first:pt-0"
            >
              <p class="font-semibold">{area.round.title} · Área {area.area_number}</p>
              <p class="mt-0.5 text-[#69726c]">{area.situation_raw} · {area.modality}</p>
            </div>
          </div>

          <div class="mt-5 grid grid-cols-[1fr_auto] gap-2">
            <button
              :if={!@watched?}
              type="button"
              id="watch-process"
              phx-click="watch"
              class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-[#1d5b45] px-4 text-sm font-semibold text-white transition hover:bg-[#174936]"
            >
              <.icon name="hero-bell" class="size-4" /> Acompanhar mudanças
            </button>
            <button
              :if={@watched?}
              type="button"
              id="unwatch-process"
              phx-click="unwatch"
              class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-[#1f2823] px-4 text-sm font-semibold text-white transition hover:bg-black"
            >
              <.icon name="hero-check" class="size-4" /> Acompanhando
            </button>
            <a
              href={official_process_url(@selected_process.process_number)}
              target="_blank"
              rel="noreferrer"
              class="grid size-11 place-items-center rounded-md border border-[#cfd5d0] bg-white transition hover:bg-[#f0f2f0]"
              title="Abrir fonte oficial ANM"
            >
              <.icon name="hero-arrow-top-right-on-square" class="size-4" />
            </a>
          </div>
          <p class="mt-4 text-[10px] leading-4 text-[#8a928d]">
            Informação de apoio. Consulte sempre o
            <a
              href="https://sople.anm.gov.br/portalpublico"
              target="_blank"
              rel="noreferrer"
              class="font-semibold underline underline-offset-2"
            >SOPLE oficial</a>
            e o processo da ANM para efeitos legais.
          </p>
        </article>
      </section>
    </div>
  </div>
</Layouts.app>
